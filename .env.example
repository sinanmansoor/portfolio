DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# ── AI assistant ────────────────────────────────────────────────────────────
# Groq Cloud API key (free & fast) — https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here
# Or an xAI Grok key instead — https://console.x.ai
# XAI_API_KEY=xai_your_xai_key_here

# Optional model override (Groq default: openai/gpt-oss-120b)
# LLM_MODEL=openai/gpt-oss-120b

# ── Visitor notification emails (optional) ──────────────────────────────────
# Gmail address + Google App Password (https://myaccount.google.com/apppasswords)
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=
VISIT_NOTIFY_EMAIL=you@gmail.com
