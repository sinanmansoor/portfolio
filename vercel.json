{
  "builds": [
    {
      "src": "portfolio_ai/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    },
    { "src": "portfolio/static/**", "use": "@vercel/static" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/static/portfolio/(.*)",
      "dest": "/portfolio/static/portfolio/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": { "cache-control": "public, max-age=3600" }
    },
    { "src": "/(.*)", "dest": "portfolio_ai/wsgi.py" }
  ]
}
